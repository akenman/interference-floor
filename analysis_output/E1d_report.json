{
  "experiment": "E1d",
  "title": "跨世界误差解剖一致性 (Cross-World Error Anatomy Consistency)",
  "pre_registration": {
    "written_at": "2026-09-05 00:00",
    "hypothesis": "卦级误差结构（坤最易、离最难）在弹球与铰链两个世界一致——说明它是相态结构的普遍性质，而非某个世界的偶然。若通过，误差解剖成为通用分析仪器；若未通过，T4 降级为'弹球世界的观察'。",
    "criteria": {
      "E1d-1": {
        "text": "两世界的卦级误差排序 Spearman ρ ≥ 0.6 且 p < 0.05",
        "threshold": "ρ ≥ 0.6, p < 0.05"
      },
      "E1d-2": {
        "text": "两世界的最易卦都是'低能/腾空'相（弹球=坤，铰链=对应相）",
        "threshold": "最易卦 = 坤 (index 0)"
      }
    }
  },
